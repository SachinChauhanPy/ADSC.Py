{
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/client"
      }
    }
  ],
  "routes": [
    { "src": "/admin/seo", "dest": "/index.html" },
    { "src": "/((?!assets/|.*\\..*).*)$", "dest": "/index.html" }
  ]
}
