# ─── Server-side only ───────────────────────────────────────
# Used by api/chat.ts. Do NOT prefix these with VITE_: Vite inlines
# every VITE_* variable into the browser bundle, which would publish
# the key to every visitor.
GROQ_API_KEY=your_groq_api_key_here

# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# Note: `npm run dev` serves the SPA only and does not run api/chat.ts,
# so the chat widget 404s locally. Use `npx vercel dev` to exercise it.
